  "cards": [
    {
      "dot": "rose",
      "title": "Locked safety rules",
      "items": [
        "Freshness is one hour; duplicate handling is enforced before acceptance.",
        "Trading Core enforces account size, planned risk, account limits, leverage, and paper mode.",
        "Signal Gate and Trading Core remain isolated from strategy plug-in logic."
      ]
    },
    {
      "dot": "cyan",
      "title": "Stable plug-in boundary",
      "items": [
        "strategies/base.py defines Signal, StrategyManifest, and Strategy lifecycle hooks.",
        "Strategy modules expose create_strategy(); the registry discovers them automatically.",
        "Shared Engine and Service own execution/persistence/notification lifecycle; plug-ins provide strategy behavior."
      ]
    },
    {
      "dot": "emerald",
      "title": "Canonical runtime outputs",
      "items": [
        "Signal events are persisted before delivery decisions.",
        "Notification Service owns delivery orchestration; telegram.py is the transport/format adapter.",
        "Database Manager covers accounts, trades, signals, deliveries, scan runs, and market-data cache; dashboard.py exposes the canonical snapshot."
      ]
    },
    {
      "dot": "amber",
      "title": "Ponytail change rule",
      "items": [
        "This architecture documents the existing runtime; it does not authorize changes to core trading logic.",
        "New strategy behavior belongs behind the Strategy Contract.",
        "UI/theme work belongs in the presentation layer and must not alter signal, risk, or trading contracts."
      ]
    }
  ]
