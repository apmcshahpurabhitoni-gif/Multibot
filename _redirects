# Route the static dashboard to its actual entry pages.
# Keep these exact routes above the API proxy.
/ /dashboard.html 200
/dashboard /dashboard.html 200
/architecture /docs/architecture/multibot2-architecture.html 200

# Netlify serves the frontend; Render owns the Python API.
# Force the proxy so Netlify never serves a static 404 for /api/*.
# X-Forwarded-Host preserves the dashboard's same-origin API guard./api/* https://multibot2-t74l.onrender.com/api/:splat 200!
